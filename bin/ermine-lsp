#!/usr/bin/env bash
# Start the Ermine language server (LSP over stdio).
#
# stdout carries the protocol; point ERMINE_LSP_LOG at a file for
# server-side logging. Builds the classpath with sbt on first run and
# caches it in target/ermine-classpath, like bin/ermine.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$here"
cache=target/ermine-classpath

if [[ ! -s $cache ]] || [[ build.sbt -nt $cache ]]; then
  mkdir -p target
  sbt -batch 'export core/fullClasspath' 2>/dev/null |
    grep -v '^\[' | grep -v '^$' | tail -1 | tr -d '\n' > "$cache"
fi

opts=( )
[[ -n ${ERMINE_LSP_LOG:-} ]] && opts+=( -Dermine.lsp.log="$ERMINE_LSP_LOG" )
# WP-5 (tracker/JSON-WIDGET-PLAYGROUND.md sections 2.2 and 2.5).  Two sessions
# live in this JVM once a preview is booted -- the resident and the render
# session -- and nothing capped the heap, so the cap was the JDK default of a
# quarter of RAM.  -Xmx makes it the same on every machine, and
# -XX:+ExitOnOutOfMemoryError turns an allocating runaway into a CLEAN EXIT the
# editor's client restarts, in place of a process that thrashes and answers
# nothing.
#
# THE TWO FLAGS ARE DECIDED SEPARATELY, and the test is on WORDS, never on a
# substring of the whole variable: a -Dermine.lsp.log=/tmp/-Xmx-logs/a.log used
# to silence BOTH of them.
#  * -Xmx is skipped when a word of ERMINE_JAVA_OPTS already sets the maximum
#    heap (-Xmx... or -XX:MaxHeapSize=...): that caller has chosen a size.
#  * -XX:+ExitOnOutOfMemoryError is ALWAYS added unless a word of
#    ERMINE_JAVA_OPTS already names ExitOnOutOfMemoryError with either sign,
#    because section 2.5's recovery depends on it: without it an OOM leaves a
#    thrashing process that answers nothing.  One line to reverse if the user
#    would rather a caller's -Xmx took the whole heap decision.
# An ERMINE_LSP_XMX that is not a heap size (a non-zero number and a k/m/g/t
# suffix, which is what the JVM accepts) is REFUSED OUT LOUD and 2g used --
# never exit here, because a launcher that refuses to start is a server the
# editor cannot run at all.  (A bad -Xmx inside ERMINE_JAVA_OPTS is the JVM's
# own to refuse: it prints "Invalid maximum heap size" and exits 1 before any
# LSP frame, which the client sees as a server that died at startup.)
# AND A FLOOR, because the spelling test alone is not enough (review nit): 1k
# and 1m are heap sizes by spelling and no use here.  64m is THIS LAUNCHER's
# floor, not the JVM's: HotSpot starts happily on far less (32m, say), it is
# the RESIDENT SESSION that cannot boot in it (129 modules, 22 MiB live and
# ~775 MiB of RSS before a full GC, section 2.2), and only at a few MB or less
# does the JVM itself refuse ("Too small maximum heap", exit 1 before any LSP
# frame).  Below the floor is refused exactly like a misspelling, out loud,
# and 2g is used.  Only a k or an m can be under it (any non-zero g or t is at
# least 1 GiB), so the test is two integer comparisons and never an
# overflowing one: a number of more than 18 digits is large, not small,
# whatever bash makes of it.
ejo=( )
[[ -n ${ERMINE_JAVA_OPTS:-} ]] && read -r -a ejo <<< "$ERMINE_JAVA_OPTS"
have_xmx=0
have_exit=0
for word in ${ejo[@]+"${ejo[@]}"}; do
  case "$word" in
    -Xmx*|-XX:MaxHeapSize=*)                                  have_xmx=1 ;;
    -XX:+ExitOnOutOfMemoryError|-XX:-ExitOnOutOfMemoryError)   have_exit=1 ;;
  esac
done
if (( ! have_xmx )); then
  xmx=${ERMINE_LSP_XMX:-2g}
  if [[ ! $xmx =~ ^[1-9][0-9]*[kKmMgGtT]$ ]]; then
    echo "ermine-lsp: ERMINE_LSP_XMX=\"$xmx\" is not a JVM heap size (a non-zero number and a k, m, g or t suffix, e.g. 2g, 512m, 2097152k); using 2g" >&2
    xmx=2g
  else
    small=0
    n=${xmx%[kKmMgGtT]}
    case "$xmx" in
      *[kK]) if (( ${#n} <= 18 )) && (( n < 65536 )); then small=1; fi ;;
      *[mM]) if (( ${#n} <= 18 )) && (( n < 64 ));    then small=1; fi ;;
    esac
    if (( small )); then
      echo "ermine-lsp: ERMINE_LSP_XMX=\"$xmx\" is below this launcher's 64m floor (a heap that small cannot boot the resident session, and at a few MB or less the JVM refuses to start at all); using 2g" >&2
      xmx=2g
    fi
  fi
  opts+=( -Xmx"$xmx" )
fi
(( have_exit )) || opts+=( -XX:+ExitOnOutOfMemoryError )
opts+=( ${ejo[@]+"${ejo[@]}"} )

# JAVA_HOME if set; else the local toolchain if it is there; else java on PATH.
if [[ -n ${JAVA_HOME:-} ]]; then
  java="$JAVA_HOME/bin/java"
elif [[ -x $HOME/.local/ermine-toolchain/jdk-21.0.12.1+1/bin/java ]]; then
  java="$HOME/.local/ermine-toolchain/jdk-21.0.12.1+1/bin/java"
else
  java=java
fi
exec "$java" "${opts[@]}" -cp "$(cat "$cache")" \
  com.clarifi.reporting.ermine.lsp.Main "$@"
