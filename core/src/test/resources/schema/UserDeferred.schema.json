        },
        {
          "type" : "object",
          "properties" : {
            "name" : {
              "const" : "sfInt"
            },
            "type" : {
              "const" : "Int"
            },
            "nullable" : {
              "const" : false
            }
          },
          "required" : [
            "name",
            "type",
            "nullable"
          ],
          "additionalProperties" : false
        },
        {
          "type" : "object",
          "properties" : {
