catEndoMonoid : forall (k: a1 -> a1 -> *) (a: a1). Control.Category.Category k -> Control.Monoid.Monoid (k a a)
comp : forall (k: a1 -> a1 -> *) (b: a1) (c: a1) (a: a1). Control.Category.Category k -> k b c -> k a b -> k a c
idC : forall (k: a1 -> a1 -> *) (a: a1). Control.Category.Category k -> k a a
