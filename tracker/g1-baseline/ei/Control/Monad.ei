bind : forall (f: * -> *) a b. Control.Monad.Monad f -> f a -> (a -> f b) -> f b
ifM : forall (m: * -> *) a. Control.Monad.Monad m -> m Builtin.Bool -> m a -> m a -> m a
join : forall (f: * -> *) a. Control.Monad.Monad f -> f (f a) -> f a
liftM : forall (f: * -> *) a b. Control.Monad.Monad f -> (a -> b) -> f a -> f b
monadAp : forall (f: * -> *). Control.Monad.Monad f -> Control.Ap.Ap f
monadFunctor : forall (f: * -> *). Control.Monad.Monad f -> Control.Functor.Functor f
unit : forall (f: * -> *) a. Control.Monad.Monad f -> a -> f a
