cons_Bracket_Simple : forall (pr: rho -> * -> *) (r: rho) a (s: rho) (t: rho). (Layout.Presentation.AsPresentation pr, t <- (r, s)) => (pr r a, Builtin.String) -> Layout.Legend.Legend s -> Layout.Legend.Legend t
