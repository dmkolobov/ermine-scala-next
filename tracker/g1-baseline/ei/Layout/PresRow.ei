cons_Bracket : forall (o: rho -> * -> *) (ra: rho) a (r: rho) (r': rho). (exists (ro: rho) (so: rho) (rs: rho). r' <- (ro, so, rs), r <- (ro, rs), ra <- (so, rs), AsPresentation o) => o ra a -> Layout.PresRow.PresRow r -> Layout.PresRow.PresRow r'
empty_Bracket : Layout.PresRow.PresRow (||)
