cons_Bracket : forall (o: rho -> * -> *) (ra: rho) a (r: rho) (r': rho). (exists (rs: rho) (so: rho) (ro: rho). AsPresentation o, ra <- (rs, so), r <- (rs, ro), r' <- (rs, so, ro)) => o ra a -> Layout.PresRow.PresRow r -> Layout.PresRow.PresRow r'
