bottomKBy : forall (h: rho) (k: rho) (rel: rho -> *) (kv: rho). (exists (c: rho) (r: rho). r <- (h, c), kv <- (k, c, h), Builtin.Relational rel) => Relation.Row.Row h -> Relation.Row.Row k -> Builtin.Int -> rel kv -> Builtin.Mem kv
