groupBy : forall (k: rho) (v: rho) (v2: rho) (rel: rho -> *) (kv: rho) (kv2: rho). (kv2 <- (k, v2), kv <- (k, v), Builtin.Relational rel) => Relation.Row.Row k -> (Builtin.Mem v -> Builtin.Mem v2) -> rel kv -> Builtin.Mem kv2
join1 : forall (k: rho) a (rel: rho -> *) (ra: rho) (rb: rho) (r: rho). (Builtin.Relational rel, r <- (k, r1, r2), rb <- (k, r2), ra <- (k, r1)) => Builtin.Field k a -> rel ra -> rel rb -> rel r
joinBy : forall (k: rho) (rel: rho -> *) (r1: rho) (r2: rho) (r: rho). (Builtin.Relational rel, r <- (k, t1, t2), r2 <- (k, t2), r1 <- (k, t1)) => Relation.Row.Row k -> rel r1 -> rel r2 -> rel r
joinBy' : forall (kh: rho) (rel: rho -> *) (r1: rho) (r2: rho) (r: rho). (Builtin.Relational rel, r <- (kh, kt, t1, t2), r2 <- (kh, kt, t2), r1 <- (kh, kt, t1)) => Relation.Row.Row kh -> rel r1 -> rel r2 -> rel r
joinWithDefault : forall (extra: rho) a (rel: rho -> *) (r1: rho) (r2: rho) (r3: rho). (exists (c: rho) (s: rho). r1 <- (c, s), Builtin.RelationalComb rel, r2 <- (c, extra), Builtin.PrimitiveAtom a, r3 <- (c, s, extra)) => Builtin.Field extra a -> a -> rel r1 -> rel r2 -> rel r3
lastBy : forall (h: rho) (r: rho). (exists (c: rho). r <- (h, c)) => Relation.Row.Row h -> Builtin.Relation r -> Builtin.Relation r
