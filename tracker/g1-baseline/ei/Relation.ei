count : forall (a: rho -> *) (b: rho). Builtin.RelationalComb a => a b -> a (|Field.Count|)
filterEq : forall (c: rho) a (r: rho). (exists (c1: rho). r <- (c, c1)) => Builtin.Field c a -> a -> Builtin.Relation r -> Builtin.Relation r
filterNEq : forall (c: rho) a (r: rho). (exists (c1: rho). r <- (c, c1)) => Builtin.Field c a -> a -> Builtin.Relation r -> Builtin.Relation r
