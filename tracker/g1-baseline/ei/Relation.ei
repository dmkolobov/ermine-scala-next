partialLookup : forall (key: rho) a (val: rho) (rel: rho -> *) (kv: rho) (r: rho). (exists (r2: rho). Builtin.RelationalComb rel, r <- (key, base), kv <- (key, val), Builtin.PrimitiveAtom a, r2 <- (key, val, base)) => Builtin.Field key a -> Builtin.Field val a -> rel kv -> rel r -> rel r
partialLookup' : forall (key: rho) a (val: rho) (rel: rho -> *) (kv: rho) (r: rho) (r2: rho). (Builtin.PrimitiveAtom a, r <- (key, base), kv <- (key, val), Builtin.RelationalComb rel, r2 <- (key, val, base)) => Builtin.Field key a -> Builtin.Field val a -> rel kv -> rel r -> rel r2
