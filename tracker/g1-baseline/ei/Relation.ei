leftJoinOr : forall (rel: rho -> *) (r1: rho) (r2: rho) (t: rho) (r3: rho). (r3 <- (r, s, t), r2 <- (s, t), r1 <- (r, s), Builtin.RelationalComb rel) => rel r1 -> rel r2 -> Builtin.Record t -> rel r3
letRWithPK : forall (k: rho) (rel: rho -> *) (a: rho) (b: rho). (exists (c: rho). a <- (k, c), Builtin.Relational rel) => Relation.Row.Row k -> rel a -> (Builtin.Relation a -> Builtin.Relation b) -> Builtin.Relation b
lookbackJoin : forall (r: rho) (r1: rho) (a: rho) (b: rho). (exists (c: rho) (r2: rho) (c1: rho) (d: rho) (e: rho) (o: rho) (f: rho) (g: rho) (t: rho) (c2: rho) (h: rho). r1 <- (c1, e), b <- (h, g, f), r1 <- (c2, r), o <- (g, f), t <- (d, c1, e), t <- (r, d, c2), r2 <- (d, c1), a <- (h, g), a <- (c, r)) => (Builtin.Field r Builtin.Date -> Relation.Op.Type.Op r Builtin.Date) -> Builtin.Field r Builtin.Date -> Builtin.Relation r1 -> Builtin.Relation a -> Builtin.Relation b
