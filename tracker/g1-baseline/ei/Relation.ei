rightJoinOr : forall (rel: rho -> *) (r1: rho) (r2: rho) (r: rho) (r3: rho). (r3 <- (r, s, t), r2 <- (s, t), r1 <- (r, s), Builtin.RelationalComb rel) => rel r1 -> rel r2 -> Builtin.Record r -> rel r3
rightJoinWithDefault : forall (extra: rho) a (rel: rho -> *) (r2: rho) (r1: rho) (r3: rho). (exists (c: rho) (s: rho). Builtin.PrimitiveAtom a, r1 <- (c, s), r3 <- (c, s, extra), r2 <- (c, extra), Builtin.RelationalComb rel) => Builtin.Field extra a -> a -> rel r2 -> rel r1 -> rel r3
row : forall (r: rho). Builtin.Record r -> Builtin.Relation r
setColumn : forall (c: rho) a (op: rho -> * -> *) (s: rho) (rel: rho -> *) (r: rho) (t: rho). (exists (ro: rho) (so: rho) (rs: rho) (o: rho). Builtin.RelationalComb rel, r <- (rs, ro), Relation.Op.AsOp op, r <- (o, s), t <- (rs, so, ro), c <- (rs, so)) => Builtin.Field c a -> op s a -> rel r -> rel t
