relationWithHeader : forall (r: rho). Relation.Row.Row r -> Builtin.List (Builtin.Record r) -> Builtin.Relation r
rename' : forall (a: rho) b (c: rho) (rel: rho -> *) (r: rho) (d: rho). (exists (e: rho) (r2: rho). d <- (e, c), r2 <- (e, a), r <- (c, a, e), Builtin.RelationalComb rel) => Builtin.Field a b -> Builtin.Field c b -> rel r -> rel d
replaceColumn : forall (r: rho) a (rel: rho -> *) (ra: rho) (rb: rho) (r2: rho). (exists (r1: rho) (r3: rho) (r21: rho). ra <- (r1, r), r3 <- (r, r2), rb <- (r21, r), Builtin.RelationalComb rel, r3 <- (r21, r1, r)) => Builtin.Field r a -> rel ra -> rel rb -> rel r2
