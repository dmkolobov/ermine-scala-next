join1 : forall (k: rho) a (rel: rho -> *) (ra: rho) (rb: rho) (r: rho). (Builtin.Relational rel, ra <- (k, r1), rb <- (k, r2), r <- (k, r1, r2)) => Builtin.Field k a -> rel ra -> rel rb -> rel r
joinBy : forall (k: rho) (rel: rho -> *) (r1: rho) (r2: rho) (r: rho). (Builtin.Relational rel, r1 <- (k, t1), r2 <- (k, t2), r <- (k, t1, t2)) => Relation.Row.Row k -> rel r1 -> rel r2 -> rel r
