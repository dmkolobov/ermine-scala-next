-- ermine-interface 2|cut+label-early+resguard+splitkey+splitrow+resrow+rsbare+rssat+rsdecide+pol:smallcanon+budget:20000+topnorm+tauto|sigEntail=error
aggregateBy : forall (h: rho) n (rel: rho -> *) (r: rho). (Builtin.Relational rel, r <- (h, t)) => (Builtin.Field h n -> Relation.Aggregate.Type.Aggregate h n) -> Builtin.Field h n -> rel r -> rel h
aggregateByGroup : forall (r: rho) a (b: rho) (f: rho) (s: rho) (t: rho). (Has s r, t <- (b, f)) => Relation.Aggregate.Type.Aggregate r a -> Relation.Row.Row b -> Builtin.Field f a -> Builtin.Relation s -> Builtin.Relation t
avg : forall (op: rho -> * -> *) (r: rho) n. (exists (AsOp: (rho -> * -> *) -> a). AsOp op, Builtin.PrimitiveNum n) => op r n -> Relation.Aggregate.Type.Aggregate r n
count : forall (a: rho -> *) (b: rho). Builtin.RelationalComb a => a b -> a (|Field.Count|)
countAgg : forall n. Builtin.PrimitiveNum n => Relation.Aggregate.Type.Aggregate (||) n
max : forall (op: rho -> * -> *) (r: rho) n. (AsOp op, Builtin.Primitive n) => op r n -> Relation.Aggregate.Type.Aggregate r n
maxBy : forall (r: rho) n (rel: rho -> *) (r1: rho). (exists (a: rho). Builtin.Primitive n, Builtin.Relational rel, r1 <- (r, a)) => Builtin.Field r n -> rel r1 -> rel r
mean : forall (op: rho -> * -> *) (r: rho) n. (AsOp op, Builtin.PrimitiveNum n) => op r n -> Relation.Aggregate.Type.Aggregate r n
meanBy : forall (r: rho) n (rel: rho -> *) (r1: rho). (exists (a: rho). Builtin.PrimitiveNum n, Builtin.Relational rel, r1 <- (r, a)) => Builtin.Field r n -> rel r1 -> rel r
min : forall (op: rho -> * -> *) (r: rho) n. (AsOp op, Builtin.Primitive n) => op r n -> Relation.Aggregate.Type.Aggregate r n
minBy : forall (r: rho) n (rel: rho -> *) (r1: rho). (exists (a: rho). Builtin.Primitive n, Builtin.Relational rel, r1 <- (r, a)) => Builtin.Field r n -> rel r1 -> rel r
standardDeviationBy : forall (r: rho) n (rel: rho -> *) (r1: rho). (exists (a: rho). Builtin.PrimitiveNum n, Builtin.Relational rel, r1 <- (r, a)) => Builtin.Field r n -> rel r1 -> rel r
stddev : forall (op: rho -> * -> *) (r: rho) n. (AsOp op, Builtin.PrimitiveNum n) => op r n -> Relation.Aggregate.Type.Aggregate r n
sum : forall (op: rho -> * -> *) (r: rho) n. (AsOp op, Builtin.PrimitiveNum n) => op r n -> Relation.Aggregate.Type.Aggregate r n
sumBy : forall (r: rho) n (rel: rho -> *) (r1: rho). (exists (a: rho). Builtin.PrimitiveNum n, Builtin.Relational rel, r1 <- (r, a)) => Builtin.Field r n -> rel r1 -> rel r
variance : forall (op: rho -> * -> *) (r: rho) n. (AsOp op, Builtin.PrimitiveNum n) => op r n -> Relation.Aggregate.Type.Aggregate r n
varianceBy : forall (r: rho) n (rel: rho -> *) (r1: rho). (exists (a: rho). Builtin.PrimitiveNum n, Builtin.Relational rel, r1 <- (r, a)) => Builtin.Field r n -> rel r1 -> rel r
weightedHarmonicMean : forall (a: rho -> * -> *) (b: rho) c (d: rho -> * -> *) (e: rho) (t: rho). (Relation.Op.AsOp a, Relation.Op.AsOp d, t <- (b, e)) => a b c -> d e c -> Relation.Aggregate.Type.Aggregate t c
weightedMean : forall (a: rho -> * -> *) (b: rho) c (d: rho -> * -> *) (e: rho) (t: rho). (Relation.Op.AsOp a, Relation.Op.AsOp d, t <- (b, e)) => a b c -> d e c -> Relation.Aggregate.Type.Aggregate t c
