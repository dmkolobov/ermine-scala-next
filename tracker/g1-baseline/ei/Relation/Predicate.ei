-- ermine-interface 2|cut+label-early+resguard+splitkey+splitrow+resrow+rsbare+rssat+rsdecide+pol:smallcanon+budget:20000+topnorm+tauto
(!=) : forall {a} (opl: rho -> a -> *) (a1: rho) (v: a) (opr: rho -> a -> *) (b: rho) (c: rho). (exists (e: rho) (f: rho) (d: rho) (AsOp: (rho -> a -> *) -> b1). a1 <- (e, d), AsOp opr, AsOp opl, c <- (f, e, d), b <- (f, e)) => opl a1 v -> opr b v -> Builtin.Predicate c
(&&) : forall (r: rho) (s: rho) (t: rho). Constraint.RUnion2 t r s => Builtin.Predicate r -> Builtin.Predicate s -> Builtin.Predicate t
(<) : forall (opl: rho -> * -> *) (a: rho) v (opr: rho -> * -> *) (b: rho) (c: rho). (exists (d: rho) (e: rho) (f: rho). c <- (d, e, f), b <- (e, f), AsOp opr, AsOp opl, a <- (d, e)) => opl a v -> opr b v -> Builtin.Predicate c
(<=) : forall {a} (opl: rho -> a -> *) (a1: rho) (v: a) (opr: rho -> a -> *) (b: rho) (t: rho). (exists (d: rho) (e: rho) (rs: rho) (so: rho) (ro: rho) (c: rho) (d1: rho) (e1: rho) (f: rho) (f1: rho) (AsOp: (rho -> a -> *) -> b1) (AsOp1: (rho -> a -> *) -> b1) (c1: rho). AsOp1 opr, AsOp1 opl, c <- (f, e1, d1), c <- (so, rs), a1 <- (e, d), a1 <- (e1, d1), AsOp opl, t <- (ro, so, rs), AsOp opr, c1 <- (f1, e, d), b <- (f, e1), b <- (f1, e), c1 <- (ro, rs)) => opl a1 v -> opr b v -> Builtin.Predicate t
(==) : forall (opl: rho -> * -> *) (a: rho) v (opr: rho -> * -> *) (b: rho) (c: rho). (exists (d: rho) (e: rho) (f: rho). a <- (d, e), AsOp opr, b <- (e, f), AsOp opl, c <- (d, e, f)) => opl a v -> opr b v -> Builtin.Predicate c
(>) : forall (opl: rho -> * -> *) (a: rho) v (opr: rho -> * -> *) (b: rho) (c: rho). (exists (d: rho) (e: rho) (f: rho). AsOp opr, c <- (d, e, f), AsOp opl, b <- (e, f), a <- (d, e)) => opl a v -> opr b v -> Builtin.Predicate c
(>=) : forall {a} (opl: rho -> a -> *) (a1: rho) (v: a) (opr: rho -> a -> *) (b: rho) (t: rho). (exists (d: rho) (e: rho) (AsOp: (rho -> a -> *) -> b1) (c: rho) (d1: rho) (e1: rho) (f: rho) (c1: rho) (f1: rho) (rs: rho) (so: rho) (ro: rho) (AsOp1: (rho -> a -> *) -> b1). c <- (f, e1, d1), c1 <- (f1, e, d), AsOp opl, AsOp1 opl, c <- (so, rs), AsOp1 opr, c1 <- (ro, rs), b <- (f, e1), a1 <- (e, d), a1 <- (e1, d1), b <- (f1, e), AsOp opr, t <- (ro, so, rs)) => opl a1 v -> opr b v -> Builtin.Predicate t
all : forall (r: rho). Builtin.Record r -> Builtin.Predicate r
not : forall (r: rho). Builtin.Predicate r -> Builtin.Predicate r
opBin : forall (r: rho) a (s: rho) b z (opl: rho -> * -> *) (opr: rho -> * -> *). (AsOp opr, AsOp opl) => (Relation.Op.Type.Op r a -> Relation.Op.Type.Op s b -> z) -> opl r a -> opr s b -> z
selectNotNulls : forall (op: rho -> * -> *) (h: rho) a (rel: rho -> *) (r: rho). (r <- (h, t), Builtin.Relational rel, AsOp op) => op h a -> rel r -> rel r
selectNulls : forall (op: rho -> * -> *) (h: rho) a (rel: rho -> *) (r: rho). (r <- (h, t), Builtin.Relational rel, AsOp op) => op h a -> rel r -> rel r
(||) : forall (r: rho) (s: rho) (t: rho). Constraint.RUnion2 t r s => Builtin.Predicate r -> Builtin.Predicate s -> Builtin.Predicate t
