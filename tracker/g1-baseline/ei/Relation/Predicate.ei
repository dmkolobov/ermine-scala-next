-- ermine-interface 2|cut+label-early+resguard+splitkey+splitrow+resrow+rsbare+rssat+rsdecide+pol:smallcanon+budget:20000+topnorm+tauto|sigEntail=error
(!=) : forall {a} (opl: rho -> a -> *) (a1: rho) (v: a) (opr: rho -> a -> *) (b: rho) (c: rho). (exists (AsOp: (rho -> a -> *) -> b1) (c1: rho) (d: rho) (e: rho). AsOp opl, AsOp opr, a1 <- (c1, d), b <- (d, e), c <- (c1, d, e)) => opl a1 v -> opr b v -> Builtin.Predicate c
(&&) : forall (r: rho) (s: rho) (t: rho). Constraint.RUnion2 t r s => Builtin.Predicate r -> Builtin.Predicate s -> Builtin.Predicate t
(<) : forall (opl: rho -> * -> *) (a: rho) v (opr: rho -> * -> *) (b: rho) (c: rho). (exists (d: rho) (e: rho) (f: rho). AsOp opl, AsOp opr, a <- (d, e), b <- (e, f), c <- (d, e, f)) => opl a v -> opr b v -> Builtin.Predicate c
(<=) : forall {a} (opl: rho -> a -> *) (a1: rho) (v: a) (opr: rho -> a -> *) (b: rho) (t: rho). (exists (AsOp: (rho -> a -> *) -> b1) (AsOp1: (rho -> a -> *) -> b1) (c: rho) (d: rho) (e: rho) (f: rho) (g: rho) (h: rho) (i: rho) (j: rho) (k: rho) (l: rho) (m: rho). AsOp opl, AsOp opr, AsOp1 opl, AsOp1 opr, a1 <- (c, d), a1 <- (e, f), b <- (d, g), b <- (f, h), t <- (i, j, k), l <- (c, d, g), l <- (i, j), m <- (e, f, h), m <- (i, k)) => opl a1 v -> opr b v -> Builtin.Predicate t
(==) : forall (opl: rho -> * -> *) (a: rho) v (opr: rho -> * -> *) (b: rho) (c: rho). (exists (d: rho) (e: rho) (f: rho). AsOp opl, AsOp opr, a <- (d, e), b <- (e, f), c <- (d, e, f)) => opl a v -> opr b v -> Builtin.Predicate c
(>) : forall (opl: rho -> * -> *) (a: rho) v (opr: rho -> * -> *) (b: rho) (c: rho). (exists (d: rho) (e: rho) (f: rho). AsOp opl, AsOp opr, a <- (d, e), b <- (e, f), c <- (d, e, f)) => opl a v -> opr b v -> Builtin.Predicate c
(>=) : forall {a} (opl: rho -> a -> *) (a1: rho) (v: a) (opr: rho -> a -> *) (b: rho) (t: rho). (exists (AsOp: (rho -> a -> *) -> b1) (AsOp1: (rho -> a -> *) -> b1) (c: rho) (d: rho) (e: rho) (f: rho) (g: rho) (h: rho) (i: rho) (j: rho) (k: rho) (l: rho) (m: rho). AsOp opl, AsOp opr, AsOp1 opl, AsOp1 opr, a1 <- (c, d), a1 <- (e, f), b <- (d, g), b <- (f, h), t <- (i, j, k), l <- (c, d, g), l <- (i, j), m <- (e, f, h), m <- (i, k)) => opl a1 v -> opr b v -> Builtin.Predicate t
all : forall (r: rho). Builtin.Record r -> Builtin.Predicate r
not : forall (r: rho). Builtin.Predicate r -> Builtin.Predicate r
opBin : forall (r: rho) a (s: rho) b z (opl: rho -> * -> *) (opr: rho -> * -> *). (AsOp opl, AsOp opr) => (Relation.Op.Type.Op r a -> Relation.Op.Type.Op s b -> z) -> opl r a -> opr s b -> z
selectNotNulls : forall (op: rho -> * -> *) (h: rho) a (rel: rho -> *) (r: rho). (AsOp op, Builtin.Relational rel, r <- (h, t)) => op h a -> rel r -> rel r
selectNulls : forall (op: rho -> * -> *) (h: rho) a (rel: rho -> *) (r: rho). (AsOp op, Builtin.Relational rel, r <- (h, t)) => op h a -> rel r -> rel r
(||) : forall (r: rho) (s: rho) (t: rho). Constraint.RUnion2 t r s => Builtin.Predicate r -> Builtin.Predicate s -> Builtin.Predicate t
