(!=) : forall {a} (opl: rho -> a -> *) (a1: rho) (v: a) (opr: rho -> a -> *) (b: rho) (c: rho). (exists (f: rho) (e: rho) (AsOp: (rho -> a -> *) -> b1) (d: rho). c <- (d, e, f), AsOp opl, AsOp opr, a1 <- (d, e), b <- (e, f)) => opl a1 v -> opr b v -> Builtin.Predicate c
(&&) : forall (r: rho) (s: rho) (t: rho). Constraint.RUnion2 t r s => Builtin.Predicate r -> Builtin.Predicate s -> Builtin.Predicate t
(<) : forall (opl: rho -> * -> *) (a: rho) v (opr: rho -> * -> *) (b: rho) (c: rho). (exists (d: rho) (e: rho) (f: rho). AsOp opr, b <- (e, f), AsOp opl, a <- (d, e), c <- (d, e, f)) => opl a v -> opr b v -> Builtin.Predicate c
(<=) : forall {a} (opl: rho -> a -> *) (a1: rho) (v: a) (opr: rho -> a -> *) (b: rho) (t: rho). (exists (AsOp: (rho -> a -> *) -> b1) (AsOp1: (rho -> a -> *) -> b1) (c: rho) (rs: rho) (ro: rho) (f: rho) (e: rho) (so: rho) (d: rho) (c1: rho) (f1: rho) (e1: rho) (d1: rho). a1 <- (d, e), c <- (ro, rs), c <- (d, e, f), b <- (e, f), b <- (e1, f1), AsOp1 opl, AsOp opl, t <- (ro, so, rs), c1 <- (so, rs), AsOp opr, AsOp1 opr, c1 <- (d1, e1, f1), a1 <- (d1, e1)) => opl a1 v -> opr b v -> Builtin.Predicate t
(==) : forall (opl: rho -> * -> *) (a: rho) v (opr: rho -> * -> *) (b: rho) (c: rho). (exists (d: rho) (e: rho) (f: rho). a <- (d, e), b <- (e, f), AsOp opr, c <- (d, e, f), AsOp opl) => opl a v -> opr b v -> Builtin.Predicate c
(>) : forall (opl: rho -> * -> *) (a: rho) v (opr: rho -> * -> *) (b: rho) (c: rho). (exists (d: rho) (e: rho) (f: rho). AsOp opl, AsOp opr, a <- (d, e), b <- (e, f), c <- (d, e, f)) => opl a v -> opr b v -> Builtin.Predicate c
(>=) : forall {a} (opl: rho -> a -> *) (a1: rho) (v: a) (opr: rho -> a -> *) (b: rho) (t: rho). (exists (AsOp: (rho -> a -> *) -> b1) (f: rho) (e: rho) (c: rho) (rs: rho) (ro: rho) (d: rho) (c1: rho) (f1: rho) (e1: rho) (d1: rho) (so: rho) (AsOp1: (rho -> a -> *) -> b1). b <- (e, f), a1 <- (d1, e1), c1 <- (d1, e1, f1), AsOp opl, t <- (ro, so, rs), c <- (ro, rs), a1 <- (d, e), c1 <- (so, rs), AsOp1 opl, b <- (e1, f1), c <- (d, e, f), AsOp1 opr, AsOp opr) => opl a1 v -> opr b v -> Builtin.Predicate t
all : forall (r: rho). Builtin.Record r -> Builtin.Predicate r
not : forall (r: rho). Builtin.Predicate r -> Builtin.Predicate r
opBin : forall (r: rho) a (s: rho) b z (opl: rho -> * -> *) (opr: rho -> * -> *). (AsOp opr, AsOp opl) => (Relation.Op.Type.Op r a -> Relation.Op.Type.Op s b -> z) -> opl r a -> opr s b -> z
selectNotNulls : forall (op: rho -> * -> *) (h: rho) a (rel: rho -> *) (r: rho). (r <- (h, t), Builtin.Relational rel, AsOp op) => op h a -> rel r -> rel r
selectNulls : forall (op: rho -> * -> *) (h: rho) a (rel: rho -> *) (r: rho). (r <- (h, t), Builtin.Relational rel, AsOp op) => op h a -> rel r -> rel r
(||) : forall (r: rho) (s: rho) (t: rho). Constraint.RUnion2 t r s => Builtin.Predicate r -> Builtin.Predicate s -> Builtin.Predicate t
